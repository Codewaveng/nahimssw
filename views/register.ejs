<!-- ═══ REGISTRATION FORM ═══════════════════════════════════════ -->
<div style="background: var(--gray-light); padding: 70px 0;">
  <div class="section" style="padding: 0 1.5rem;">
    <div class="section-header animate-on-scroll" style="margin-bottom:36px;">
      <div class="section-tag"><i data-feather="edit-3"></i> Register</div>
      <h2>Secure Your Spot</h2>
      <p>Fill in your details — takes less than a minute</p>
    </div>

    <div style="max-width: 640px; margin: 0 auto; background:#fff; border:1.5px solid var(--border); border-radius: var(--radius-lg); padding: 40px 36px; box-shadow: var(--shadow);" class="animate-on-scroll">

      <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:#FEF2F2;border:1.5px solid #FECACA;border-radius:var(--radius);padding:14px 18px;color:#DC2626;font-size:14px;font-weight:600;margin-bottom:24px;display:flex;gap:10px;align-items:center;">
        <i data-feather="alert-circle" style="width:16px;height:16px;flex-shrink:0;"></i> <%= error %>
      </div>
      <% } %>

      <form method="POST" action="/register/ai-web3-launchpad" onsubmit="handleSubmit(event)">

        <div class="reg-field-row">
          <div class="reg-field">
            <label>Full Name</label>
            <input type="text" name="fullName" placeholder="Your full name" required autocomplete="name">
          </div>
          <div class="reg-field">
            <label>School / University</label>
            <input type="text" name="school" placeholder="e.g. LAUTECH, UI, OAU" required>
          </div>
        </div>

        <div class="reg-field-row">
          <div class="reg-field">
            <label>Region</label>
            <select name="region" id="regionSelect" required onchange="updateStates()">
              <option value="" disabled selected>Select region</option>
              <option value="Southwest (Zone D)">Southwest (Zone D)</option>
              <option value="South-South">South-South</option>
              <option value="Southeast">Southeast</option>
              <option value="North Central">North Central</option>
              <option value="Northwest">Northwest</option>
              <option value="Northeast">Northeast</option>
            </select>
          </div>
          <div class="reg-field">
            <label>State</label>
            <select name="state" id="stateSelect" required>
              <option value="" disabled selected>Select state</option>
            </select>
          </div>
        </div>

        <!-- Knowledge section -->
        <div style="margin-bottom: 24px;">
          <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--gray);margin-bottom:14px;display:flex;align-items:center;gap:8px;">
            <i data-feather="bar-chart-2" style="width:14px;height:14px;"></i> Your Background (helps us tailor the sessions)
          </div>

          <div class="toggle-block">
            <div>
              <div class="toggle-block-label">Web3 / Blockchain Knowledge</div>
              <div class="toggle-block-sub">Have you used a crypto wallet, dApp, or studied blockchain?</div>
            </div>
            <div class="yn-wrap">
              <div class="yn-opt yn-yes">
                <input type="radio" name="knowsWeb3" id="web3yes" value="yes" required>
                <label for="web3yes">Yes</label>
              </div>
              <div class="yn-opt yn-no">
                <input type="radio" name="knowsWeb3" id="web3no" value="no">
                <label for="web3no">No</label>
              </div>
            </div>
          </div>

          <div class="toggle-block">
            <div>
              <div class="toggle-block-label">Artificial Intelligence (AI) Knowledge</div>
              <div class="toggle-block-sub">Have you used AI tools or studied machine learning?</div>
            </div>
            <div class="yn-wrap">
              <div class="yn-opt yn-yes">
                <input type="radio" name="knowsAI" id="aiyes" value="yes" required>
                <label for="aiyes">Yes</label>
              </div>
              <div class="yn-opt yn-no">
                <input type="radio" name="knowsAI" id="aino" value="no">
                <label for="aino">No</label>
              </div>
            </div>
          </div>

          <div class="toggle-block">
            <div>
              <div class="toggle-block-label">Tech / Programming Background</div>
              <div class="toggle-block-sub">Do you code or have any programming knowledge?</div>
            </div>
            <div class="yn-wrap">
              <div class="yn-opt yn-yes">
                <input type="radio" name="knowsTech" id="techyes" value="yes" required>
                <label for="techyes">Yes</label>
              </div>
              <div class="yn-opt yn-no">
                <input type="radio" name="knowsTech" id="techno" value="no">
                <label for="techno">No</label>
              </div>
            </div>
          </div>
        </div>

        <div class="cert-notice">
          <i data-feather="award"></i>
          <div class="cert-notice-text"><strong>Certificate of Participation</strong> will be issued to every attendee who completes the event — no prior experience required.</div>
        </div>

        <button type="submit" class="reg-submit" id="submitBtn">
          <i data-feather="send"></i>
          <span id="btnText">Register Now — It is Free</span>
        </button>

        <p style="text-align:center;font-size:12px;color:var(--gray);margin-top:14px;">
          By registering you agree to join our Telegram channel where all sessions are hosted.
        </p>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
const STATES = {
  'Southwest (Zone D)':['Ekiti','Kwara','Lagos','Ogun','Ondo','Osun','Oyo'],
  'South-South':['Akwa Ibom','Bayelsa','Cross River','Delta','Edo','Rivers'],
  'Southeast':['Abia','Anambra','Ebonyi','Enugu','Imo'],
  'North Central':['Benue','FCT (Abuja)','Kogi','Nasarawa','Niger','Plateau'],
  'Northwest':['Jigawa','Kaduna','Kano','Katsina','Kebbi','Sokoto','Zamfara'],
  'Northeast':['Adamawa','Bauchi','Borno','Gombe','Taraba','Yobe']
};
function updateStates() {
  const r = document.getElementById('regionSelect').value;
  const s = document.getElementById('stateSelect');
  s.innerHTML = '<option value="" disabled selected>Select state</option>';
  (STATES[r]||[]).forEach(v => { const o = document.createElement('option'); o.value=v; o.textContent=v; s.appendChild(o); });
}
function handleSubmit() {
  const btn = document.getElementById('submitBtn');
  const txt = document.getElementById('btnText');
  btn.disabled = true;
  txt.textContent = 'Submitting...';
}
</script>
