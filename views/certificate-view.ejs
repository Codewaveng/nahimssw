<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>NAHIMS SW Certificate — <%= certificate.fullName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box}body{margin:0;background:#edf1f0;color:#14251f;font-family:'DM Sans',sans-serif}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px max(20px,calc((100% - 1100px)/2));background:#073d2e;color:#fff}.toolbar span{font-size:14px;font-weight:600}.actions{display:flex;gap:10px}.actions a{padding:11px 16px;border-radius:7px;text-decoration:none;font-weight:700;font-size:13px}.back{color:#fff;border:1px solid #ffffff55}.download{background:#d2a642;color:#14251f}.wrap{padding:42px 20px 60px}.cert{position:relative;max-width:1060px;min-height:690px;margin:auto;padding:56px 76px 38px;background:linear-gradient(140deg,#fff 0%,#fffdf8 100%);border:8px double #0b6e4f;box-shadow:0 18px 60px #17382a22;text-align:center;overflow:hidden}.cert:before,.cert:after{content:'';position:absolute;inset:12px;border:1px solid #c49a42;pointer-events:none}.seal{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:390px;height:390px;border:1px solid #0b6e4f0b;border-radius:50%;display:grid;place-items:center;color:#0b6e4f08;font-weight:800;font-size:40px;letter-spacing:8px;pointer-events:none}.inner{position:relative;z-index:1}.brand{display:flex;align-items:center;justify-content:center;gap:18px;color:#073d2e}.brand img{width:64px;height:64px;object-fit:contain}.brand-name{font-weight:800;letter-spacing:2px;font-size:15px}.brand-sub{font-size:10px;letter-spacing:3px;color:#707a75;margin-top:5px}.rule{height:1px;background:linear-gradient(90deg,transparent,#c49a42,transparent);margin:22px auto;width:75%}.eyebrow{font-size:11px;letter-spacing:4px;color:#a57b25;font-weight:800;margin:16px 0}.title{font:800 38px 'Playfair Display',serif;color:#073d2e;margin:12px 0}.intro{font:italic 18px 'Playfair Display',serif;color:#66716c;margin:24px 0 12px}.name{font:700 clamp(34px,5.2vw,54px) 'Playfair Display',serif;color:#0b6e4f;margin:0 auto 10px;overflow-wrap:anywhere}.body{font-size:15px;line-height:1.85;color:#4f5a55;max-width:760px;margin:26px auto}.body strong{color:#173b2d}.event{display:inline-block;margin:5px auto 24px;padding:12px 24px;border:1px solid #d6b45f;background:#fffcf2;color:#785914;font-weight:800;letter-spacing:.5px}.event small{display:block;margin-top:5px;font-size:12px;font-weight:600;letter-spacing:.2px}.signatures{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:42px;margin:23px auto 0;max-width:820px}.signature{display:flex;flex-direction:column;align-items:center;gap:6px}.signature b{display:block;color:#073d2e;font-size:13px}.signature span{font-size:11px;color:#66716c}.seal-stamp{width:78px;height:78px;border:2px solid #bd9131;outline:1px solid #bd9131;outline-offset:3px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#0b6e4f;font-size:9px;font-weight:800;letter-spacing:.8px;line-height:1.5;text-align:center;background:#fffdf8}.seal-stamp em{font-style:normal;color:#a57b25;font-size:7px}.serial{margin-top:24px;font-size:9px;color:#87908b;letter-spacing:1px}.note{text-align:center;margin:18px auto 0;color:#68736e;font-size:12px}@media(max-width:650px){.toolbar{align-items:flex-start;flex-direction:column}.wrap{padding:20px 10px}.cert{padding:38px 23px 28px;min-height:0;border-width:5px}.brand img{width:46px;height:46px}.brand-name{font-size:11px;letter-spacing:1px}.brand-sub{font-size:8px;letter-spacing:1px}.title{font-size:27px}.body{font-size:13px}.signatures{grid-template-columns:1fr;gap:22px}.actions a{padding:10px 12px}}
    @media print{@page{size:A4 landscape;margin:0}body{background:#fff}.toolbar,.note{display:none}.wrap{padding:0}.cert{width:297mm;height:210mm;max-width:none;min-height:0;padding:17mm 20mm 10mm;box-shadow:none;border-width:2mm}.brand img{width:18mm;height:18mm}.title{font-size:28pt}.name{font-size:38pt}.body{font-size:11pt;margin:8mm auto}.signatures{margin-top:7mm}}
  </style>
  <style>
    .signature-image{display:block;width:155px;height:64px;object-fit:contain;mix-blend-mode:multiply}
    .signature-rule{width:84%;border-top:1px solid #0b6e4f;margin-top:-3px}
  </style>
</head>
<body>
  <header class="toolbar"><span id="downloadStatus">Preparing your certificate PDF…</span><nav class="actions"><a class="back" href="<%= certificate.event === 'Onboard3 Connect: Royal Institute #1' ? '/certificate/royal-institute' : certificate.event === 'Onboard3 Connect: De Potter #1' ? '/certificate/de-potter' : '/certificate' %>">Issue another</a><a id="downloadCertificate" class="download" href="/certificate/download/<%= certificate._id %>" download="NAHIMS-SW-Certificate.pdf">Save PDF to phone</a></nav></header>
  <main class="wrap">
    <article class="cert">
      <div class="seal">NAHIMS SW</div>
      <div class="inner">
        <div class="brand"><img src="/logo.png" alt="NAHIMS SW logo"><div><div class="brand-name">NATIONAL ASSOCIATION OF HEALTH INFORMATION MANAGEMENT STUDENTS</div><div class="brand-sub">SOUTHWEST ZONE · ZONE D</div></div></div>
        <div class="rule"></div><div class="eyebrow">OFFICIAL RECOGNITION</div>
        <h1 class="title">Certificate of Attendance</h1>
        <p class="intro">This is to certify that</p>
        <div class="name"><%= certificate.fullName %></div>
        <div class="rule"></div>
        <p class="body">has attended and participated in <strong><%= certificate.event %></strong>, contributing to a gathering dedicated to digital innovation, technology skills and the advancement of health information management.</p>
        <div class="event"><%= certificate.event.toUpperCase() %><small><%= certificate.venue %> · <%= new Date(certificate.eventDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) %></small></div>
        <div class="signatures">
          <div class="signature"><img class="signature-image" src="/gensecsign.jpg" alt="Signature of Comrade Abdulfatah Abdullahi"><div class="signature-rule"></div><b>Comrade Abdulfatah Abdullahi</b><span>General Secretary, NAHIMS SW</span></div>
          <div class="signature"><img class="signature-image" src="/dotsign.jpg" alt="Signature of Comrade Kolawole Abdullahi Adeshina"><div class="signature-rule"></div><b>Comrade Kolawole Abdullahi Adeshina</b><span>Director of Technology, NAHIMS SW</span></div>
        </div>
        <div class="serial">CERTIFICATE NO. <%= certificate.certificateNumber %></div>
      </div>
    </article>
    <p class="note">Your certificate record is saved. Tap “Save PDF to phone” to open your device’s save options. On iPhone choose Save to Files; on Android choose an available save or download option.</p>
  </main>
  <script>
    const downloadLink = document.getElementById('downloadCertificate');
    const downloadStatus = document.getElementById('downloadStatus');
    let certificateFile = null;
    let certificateUrl = null;
    const filename = 'NAHIMS-SW-Certificate-<%= certificate.fullName.replace(/[^a-zA-Z0-9]+/g, "-").replace(/^-|-$/g, "") %>.pdf';
    downloadLink.setAttribute('aria-disabled', 'true');
    downloadLink.style.pointerEvents = 'none';
    function directDownload() {
      const saveLink = document.createElement('a');
      saveLink.href = certificateUrl;
      saveLink.download = filename;
      document.body.appendChild(saveLink);
      saveLink.click();
      saveLink.remove();
    }
    fetch(downloadLink.href, { credentials: 'same-origin' })
      .then(response => { if (!response.ok) throw new Error('Download request failed'); return response.blob(); })
      .then(blob => {
        certificateFile = new File([blob], filename, { type: 'application/pdf' });
        certificateUrl = URL.createObjectURL(blob);
        let canShareFile = false;
        try { canShareFile = !!(navigator.share && navigator.canShare && navigator.canShare({ files: [certificateFile] })); } catch (error) {}
        downloadLink.removeAttribute('aria-disabled');
        downloadLink.style.pointerEvents = '';
        downloadLink.textContent = canShareFile ? 'Save PDF to phone' : 'Download PDF';
        downloadStatus.textContent = canShareFile ? 'Your PDF is ready. Tap Save PDF to open your phone’s save options.' : 'Your PDF is ready to download.';
        if (!canShareFile) directDownload();
      })
      .catch(() => {
        downloadLink.removeAttribute('aria-disabled');
        downloadLink.style.pointerEvents = '';
        downloadStatus.textContent = 'Tap the button to download your certificate PDF.';
      });

    downloadLink.addEventListener('click', event => {
      event.preventDefault();
      if (!certificateFile) { downloadStatus.textContent = 'Your PDF is still being prepared. Please tap again in a moment.'; return; }
      if (navigator.share && navigator.canShare && navigator.canShare({ files: [certificateFile] })) {
        navigator.share({ files: [certificateFile], title: 'NAHIMS SW Certificate' })
          .then(() => { downloadStatus.textContent = 'Choose Save to Files or another save option in the menu.'; })
          .catch(error => { if (error.name !== 'AbortError') downloadStatus.textContent = 'The save menu could not open. Tap again to retry.'; });
        return;
      }
      directDownload();
      downloadStatus.textContent = 'PDF download started. Check your Downloads or Files app.';
    });
  </script>
</body>
</html>
