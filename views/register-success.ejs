<%- include('partials/head', {title: 'Registration Confirmed — AI & Web3 Launchpad'}) %>
<%- include('partials/navbar') %>

<style>
  .success-hero { background: linear-gradient(135deg, #0B6E4F 0%, #064e38 60%, #0a5c43 100%); padding: 80px 1.5rem 70px; text-align: center; position: relative; overflow: hidden; }
  .success-hero::before { content:''; position:absolute; top:-60px; right:-80px; width:320px; height:320px; background:rgba(255,255,255,0.04); border-radius:50%; }
  .success-hero::after { content:''; position:absolute; bottom:-80px; left:-60px; width:280px; height:280px; background:rgba(239,159,39,0.08); border-radius:50%; }
  .check-circle { width:80px; height:80px; border-radius:50%; background:rgba(255,255,255,0.12); border:2.5px solid rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center; margin:0 auto 24px; position:relative; z-index:1; }
  .check-circle svg { width:36px; height:36px; color:#fff; }
  .success-hero h1 { font-size: clamp(26px,5vw,40px); font-weight:900; color:#fff; margin-bottom:12px; position:relative;z-index:1; }
  .success-hero h1 span { color: var(--gold-mid); }
  .success-hero p { font-size:16px; color:rgba(255,255,255,0.75); max-width:560px; margin:0 auto; line-height:1.6; position:relative;z-index:1; }
  .success-eyebrow { display:inline-flex; align-items:center; gap:6px; background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.2); border-radius:100px; padding:6px 16px; font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:rgba(255,255,255,0.9); margin-bottom:20px; position:relative;z-index:1; }
  .success-eyebrow svg { width:12px; height:12px; }

  .tg-card { background:#fff; border:2px solid #22c55e; border-radius:var(--radius-lg); padding:36px 32px; max-width:640px; margin:0 auto; box-shadow:0 0 0 6px rgba(34,197,94,0.08); }
  .tg-required-badge { display:inline-flex; align-items:center; gap:6px; background:#FEF2F2; border:1.5px solid #FECACA; border-radius:100px; padding:5px 14px; font-size:11px; font-weight:700; color:#DC2626; letter-spacing:.5px; text-transform:uppercase; margin-bottom:16px; }
  .tg-required-badge svg { width:12px;height:12px; }
  .tg-card h2 { font-size:22px; font-weight:800; color:var(--dark); margin-bottom:10px; }
  .tg-card p { font-size:14px; color:var(--gray); line-height:1.6; margin-bottom:24px; }
  .tg-btn { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; padding:16px; background:linear-gradient(135deg,#16a34a,#15803d); border:none; border-radius:var(--radius); color:#fff; font-family:inherit; font-size:16px; font-weight:800; text-decoration:none; cursor:pointer; transition:var(--transition); }
  .tg-btn:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(22,163,74,0.3); }
  .tg-btn svg { width:20px;height:20px;flex-shrink:0; }
  .tg-copy-hint { font-size:12px; color:var(--gray); margin-top:12px; text-align:center; line-height:1.5; }
  .tg-copy-hint strong { color:var(--dark); }

  .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; max-width:640px; margin:0 auto; }
  @media(max-width:480px){ .detail-grid{ grid-template-columns:1fr; } }
  .detail-item { background:#fff; border:1.5px solid var(--border); border-radius:var(--radius); padding:16px; }
  .detail-lbl { font-size:10px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:var(--gray); margin-bottom:5px; display:flex; align-items:center; gap:5px; }
  .detail-lbl svg { width:11px;height:11px; }
  .detail-val { font-size:15px; font-weight:800; color:var(--dark); }

  .success-links { display:flex; justify-content:center; gap:18px; flex-wrap:wrap; }
  .success-links a { font-size:13px; color:var(--gray); text-decoration:none; display:flex; align-items:center; gap:5px; font-weight:600; transition:var(--transition); }
  .success-links a:hover { color:var(--green); }
  .success-links a svg { width:14px;height:14px; }
</style>

<!-- ═══ HERO ═══════════════════════════════════════════════════ -->
<div class="success-hero">
  <div class="success-eyebrow"><i data-feather="check-circle"></i> Registration Confirmed</div>
  <div class="check-circle"><i data-feather="check"></i></div>
  <h1>You are <span>officially in</span><br>the Launchpad!</h1>
